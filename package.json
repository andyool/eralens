{
  "name": "eralens",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An interactive, zoomable map of time — every point is an event, discovery, person, work or historical change. A modern, responsive, accessible clone of Histography.io.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch:wikidata": "node scripts/fetch-wikidata.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^4.1.10"
  }
}
